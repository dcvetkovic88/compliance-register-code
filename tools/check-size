#!/usr/bin/env bash
# tools/check-size [--root <folder>] (T1.12): a Python module of services/ or libs/ is at most 300 lines.
# See tools/structure_checks.py; make lint runs it.
set -euo pipefail
tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --quiet --project "$tools_dir" --frozen python "$tools_dir/structure_checks.py" size "$@"
