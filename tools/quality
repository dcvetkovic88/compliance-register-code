#!/usr/bin/env bash
# The checks behind make lint, format-check, typecheck and test (plan D1; 111-FR2, 111-AC2; OD-21).
# Each check runs for the three languages: the Maven build, every npm workspace and every uv project.
# Until its tooling block lands (1b for Java, 1c for TypeScript and Python), a check fails and names
# the missing tool, and runs nothing: no target passes without running a check. A block adds its
# tool to pom.xml, the root package.json or tools/pyproject.toml; this script stays as it is.
# Usage: tools/quality <check> [java] [typescript] [python]; with no language it checks all three,
# as make does. A CI job of one language names it, so it is required as soon as its block lands.
set -euo pipefail

check="${1:-}"
shift || true
languages=("$@")
if [ ${#languages[@]} -eq 0 ]; then languages=(java typescript python); fi
for language in "${languages[@]}"; do
  case "$language" in
    java | typescript | python) ;;
    *) echo "tools/quality: unknown language $language (java, typescript or python)" >&2; exit 2 ;;
  esac
done
selected() { [[ " ${languages[*]} " == *" $1 "* ]]; }
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# Per check: the Maven goals, the npm script, and the tool each language needs for it.
case "$check" in
  lint) maven=(verify -DskipTests) npm_script=lint java_tools=(maven-checkstyle-plugin maven-pmd-plugin) \
    typescript_tool=eslint python_tool=ruff ;;
  format-check) maven=(validate) npm_script=format:check java_tools=(spotless-maven-plugin) \
    typescript_tool=prettier python_tool=ruff ;;
  typecheck) maven=(test-compile) npm_script=typecheck java_tools=(error_prone_core) \
    typescript_tool=typescript python_tool=mypy ;;
  test) maven=(test) npm_script=test java_tools=(junit-jupiter) typescript_tool=vitest python_tool=pytest ;;
  *) echo "usage: tools/quality lint|format-check|typecheck|test [java] [typescript] [python]" >&2; exit 2 ;;
esac

missing=()

for tool in "${java_tools[@]}"; do
  if selected java && ! grep -q "<artifactId>$tool</artifactId>" pom.xml 2>/dev/null; then
    missing+=("Java: $tool is not in pom.xml (block 1b adds it)")
  fi
done

if selected typescript && ! node -e 'const m = require("./package.json"); process.exit(process.argv[1] in {...m.dependencies, ...m.devDependencies} ? 0 : 1)' \
  "$typescript_tool" 2>/dev/null; then
  missing+=("TypeScript: $typescript_tool is not in package.json (block 1c adds it)")
fi

if selected python && ! grep -Eq "\"$python_tool[=<>~!]" tools/pyproject.toml 2>/dev/null; then
  missing+=("Python: $python_tool is not in tools/pyproject.toml (block 1c adds it)")
fi

if [ ${#missing[@]} -gt 0 ]; then
  for line in "${missing[@]}"; do echo "$check: missing tool for $line" >&2; done
  echo "$check: failed, ${#missing[@]} tool(s) missing; no check ran" >&2
  exit 1
fi

run() {
  echo "$check: $*"
  "$@"
}

# Lint first runs the repository structure checks of T1.12, whatever the language: the language rule, the
# own-schema rule of service SQL and the Python module length. Each runs, then lint fails if one failed.
structure_checks() {
  local name failed=0
  for name in check-language check-sql-schemas check-size; do
    if [ -x "tools/$name" ]; then run "tools/$name" || failed=1; fi
  done
  return "$failed"
}
if [ "$check" = lint ]; then structure_checks; fi

# Java: the parent build, with the plugins it binds to the lifecycle phase.
java_check() {
  run ./mvnw -B -ntp -q "${maven[@]}"
}

# TypeScript: the script of the same name in every npm workspace that has one; each workspace runs the root
# configuration (T1.10): eslint.config.mjs, .prettierrc.json, tsconfig.base.json, vitest.shared.mjs. Lint first
# runs the dependency rules of .dependency-cruiser.cjs (AR-W2 to AR-W7) on apps/ and packages/.
typescript_check() {
  local pattern directory
  for pattern in $(node -e 'for (const w of require("./package.json").workspaces ?? []) console.log(w)'); do
    for directory in $pattern; do
      if [ -f "$directory/package.json" ]; then
        if [ "$check" = lint ]; then
          run npm exec --no -- depcruise --config .dependency-cruiser.cjs $(ls -d apps packages 2>/dev/null)
        fi
        run npm run --workspaces --if-present "$npm_script"
        return
      fi
    done
  done
  echo "$check: no npm workspace has a package.json yet"
}

# Python: every uv project, with the root ruff.toml, mypy.ini and .importlinter (T1.9). The tools project also
# lints and type-checks the root tests/, which run in their suite (make suite), not here. A project with an
# `app` package is a service: lint also runs its import contracts (AR-P2 to AR-P5). mypy is strict on code;
# test folders keep pytest fixtures and test functions unannotated (mypy.ini). The test check writes a
# coverage report per project to coverage/python/, never a gate (SA-3-5), and passes on an empty test run.
python_projects() {
  echo tools
  find . -name pyproject.toml -not -path './tools/*' \
    -not -path '*/node_modules/*' -not -path '*/.venv/*' -not -path '*/fixtures/*' -not -path './.specify/*' \
    | sed -e 's|^\./||' -e 's|/pyproject.toml$||' | sort
}

test_folders() {
  if [ -d "$1/tests" ]; then echo "$1/tests"; fi
  if [ "$1" = tools ] && [ -d tests ]; then echo tests; fi
}

python_check() {
  local project folders folder status
  for project in $(python_projects); do
    folders=("$project")
    if [ "$project" = tools ] && [ -d tests ]; then folders+=(tests); fi
    case "$check" in
      lint)
        run uv run --project "$project" --frozen ruff check "${folders[@]}"
        if [ -d "$project/app" ]; then
          (cd "$project" && run uv run --frozen lint-imports --config "$root/.importlinter" --no-cache)
        fi
        ;;
      format-check)
        run uv run --project "$project" --frozen ruff format --check "${folders[@]}"
        ;;
      typecheck)
        run uv run --project "$project" --frozen mypy --config-file mypy.ini --exclude '(^|/)tests/' "$project"
        for folder in $(test_folders "$project"); do
          run uv run --project "$project" --frozen mypy --config-file mypy.ini \
            --allow-untyped-defs --allow-incomplete-defs --allow-untyped-calls "$folder"
        done
        ;;
      test)
        status=0
        run uv run --project "$project" --frozen pytest -q --rootdir "$project" -c "$project/pyproject.toml" \
          --cov="$project" --cov-report=term --cov-report="xml:coverage/python/$(basename "$project").xml" \
          "$project" || status=$?
        if [ "$status" -eq 5 ]; then
          echo "$check: $project has no test yet, an empty test run passes"
        elif [ "$status" -ne 0 ]; then
          return "$status"
        fi
        ;;
    esac
  done
}

if selected java; then java_check; fi
if selected typescript; then typescript_check; fi
if selected python; then python_check; fi
