#!/usr/bin/env bash
# The Python mutation gate of a pull request (T1.9; SA-3-4, SA-4-6; OD-25): mutmut on the Python modules changed
# since --base, failing below the threshold of tdd-profile.yaml. See tools/python_mutation_gate.py.
set -euo pipefail
tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --quiet --project "$tools_dir" --frozen python "$tools_dir/python_mutation_gate.py" "$@"
