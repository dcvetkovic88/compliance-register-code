#!/usr/bin/env bash
# tools/sync-spectral (T1.11; SA-1.2-16, SA-4-7): sync the Spectral rule set and ratchet list from the spec repository (--spec-repo or SPEC_REPO_DIR); --check compares them.
# See tools/spectral_contracts.py.
set -euo pipefail
tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --quiet --project "$tools_dir" --frozen python "$tools_dir/spectral_contracts.py" sync "$@"
