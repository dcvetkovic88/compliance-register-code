# local Claude settings, never shared
.claude/settings.local.json
# Spec Kit download cache
.specify/extensions/.cache/
# build output and tool caches
target/
node_modules/
dist/
build/
coverage/
.coverage
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
# local dev stack: secrets, logs, demo snapshot
.dev-stack/
.env
.env.*
!.env.example
# editors and OS
.idea/
.vscode/
.DS_Store
# browser test output
test-results/
playwright-report/
# JUnit XML reports of tools/suite, read by tools/check-suites
/.suite-reports/
